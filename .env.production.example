APP_NAME=Noirdrop
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://noirdrop.co.uk

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Production Database (MySQL / MariaDB on Hostinger or VPS)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=noirdrop_prod
DB_USERNAME=noirdrop_db_user
DB_PASSWORD=YOUR_SECURE_DATABASE_PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.noirdrop.co.uk

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# AI Engine API Key
DEEPSEEK_API_KEY=sk-YOUR_LIVE_DEEPSEEK_OR_AI_API_KEY

# Hostinger PrivateEmail SMTP Configuration (noirdrop.co.uk)
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=support@noirdrop.co.uk
MAIL_PASSWORD=YOUR_HOSTINGER_PRIVATEEMAIL_PASSWORD
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="support@noirdrop.co.uk"
MAIL_FROM_NAME="Noirdrop (HARTDELL LIMITED)"

VITE_APP_NAME="${APP_NAME}"
